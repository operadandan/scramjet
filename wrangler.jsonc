{
  // Cloudflare builds and deploys this on every push to main (Workers Builds).
  "name": "study",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node build.mjs" },
  // Signaling database for the peer-to-peer rooms. No ID on purpose: the deploy keeps
  // whichever D1 database is already bound as DB on the Worker (or creates one if none is).
  "d1_databases": [{ "binding": "DB" }],
  // Keep variables set in the dashboard (the optional TURN_KEY_ID). Secrets are always kept.
  "keep_vars": true,
  "workers_dev": true
}
